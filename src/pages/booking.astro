---
// src/pages/booking.astro
import '../styles/global.css';
import BookingSystem from '../components/BookingSystem.jsx';
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Book Consultation | Vita Harmony TCM</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body class="bg-[#F9F8F4] text-[#1A1C19] font-sans">
    <nav class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-[#4A5D4E]/10 px-8 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-serif font-bold text-[#4A5D4E]">元和堂</a>
        <a href="/" class="text-xs uppercase tracking-widest font-bold text-gray-400 hover:text-[#4A5D4E]">Back to Home</a>
    </nav>

    <main class="pt-32 pb-20 px-6">
        <div class="max-w-4xl mx-auto text-center mb-12">
            <h1 class="text-4xl font-serif text-[#4A5D4E] mb-4">Start Your Healing Journey</h1>
            <p class="text-gray-500">Select a service and find a time that balances with your schedule.</p>
        </div>

        <!-- This is the Interactive React Component -->
        <BookingSystem client:load />
    </main>
</body>
</html>