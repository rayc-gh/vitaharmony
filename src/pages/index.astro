---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Vita Harmony TCM | 元和堂</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body class="bg-[#F9F8F4] text-[#1A1C19] font-sans">
    <nav class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-[#4A5D4E]/10 px-8 py-4 flex justify-between items-center">
        <div class="text-2xl font-serif font-bold text-[#4A5D4E]">元和堂 <span class="text-xs font-light tracking-[0.2em] ml-2 text-[#C5A059] uppercase hidden md:inline">Vita Harmony</span></div>
        <div class="flex gap-6 items-center">
            <a href="/admin" class="text-[10px] uppercase tracking-widest font-bold text-gray-400 hover:text-[#C5A059] transition-colors">Staff Portal</a>
            <a href="/booking" class="bg-[#4A5D4E] text-white px-6 py-2 rounded-full text-xs font-bold uppercase tracking-widest hover:bg-[#3d4d41] transition-all">Book Now</a>
        </div>
    </nav>

    <main>
        <section class="h-screen flex items-center justify-center relative overflow-hidden bg-[#F9F8F4]">
            <div class="text-center z-10 px-4">
                <h2 class="text-[#C5A059] tracking-[0.4em] uppercase text-xs mb-6 font-bold">Ancient Wisdom • Modern Precision</h2>
                <h1 class="text-6xl md:text-8xl font-serif text-[#4A5D4E] mb-8">Vita Harmony</h1>
                <p class="max-w-2xl mx-auto text-lg text-gray-500 font-light leading-relaxed mb-10">Restore your natural equilibrium through personalized Traditional Chinese Medicine in the heart of Singapore.</p>
                <div class="flex gap-4 justify-center">
                    <a href="/booking" class="bg-[#4A5D4E] text-white px-10 py-4 rounded-full text-xs uppercase tracking-widest font-bold hover:shadow-xl transition-all">Schedule Consultation</a>
                </div>
            </div>
            {/* Subtle background texture */}
            <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/natural-paper.png')]"></div>
        </section>
    </main>
</body>
</html>